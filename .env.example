# OpenCred environment variables
#
# Copy this file to `.env` (which is gitignored) and fill in real values for
# local development, or set these as environment variables in your hosting
# platform (e.g. Render, Heroku, Fly.io).

# Full MongoDB connection string. Required in hosted deployments, where there
# is no MongoDB on localhost. For MongoDB Atlas, use the SRV connection string
# from Atlas > Connect > Drivers (URL-encode special characters in the
# password). When unset, OpenCred defaults to mongodb://localhost:27017.
# Example:
# MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/opencred?retryWrites=true&w=majority
MONGODB_URL=

# Optional: override the database name (default: opencred_localhost).
# Ignored when the database name is already present in MONGODB_URL.
# MONGODB_NAME=opencred

# Optional: HTTP port to listen on. Hosted platforms set this automatically.
# Defaults to 22080 for local development.
# PORT=22080
